{
  "name": "BlogComment",
  "type": "object",
  "properties": {
    "blog_slug": {
      "type": "string",
      "description": "Yorumun yap\u0131ld\u0131\u011f\u0131 yaz\u0131n\u0131n adresi (\u00f6r. web-sitesi-fiyatlari-rehberi)"
    },
    "author_name": {
      "type": "string",
      "description": "Yorumu yazan\u0131n ad\u0131"
    },
    "text": {
      "type": "string",
      "description": "Yorum metni"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved"
      ],
      "default": "pending",
      "description": "Yorumlar y\u00f6netici onay\u0131ndan sonra yay\u0131na girer"
    }
  },
  "required": [
    "blog_slug",
    "author_name",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}